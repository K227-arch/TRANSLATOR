# ── Stage 1: build wheels ────────────────────────────────────────────────────
# Compile/install all Python deps in a throw-away image so the final image
# doesn't need gcc, build-essential or the pip caches.
FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.aws.txt .
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir --prefix=/install -r requirements.aws.txt


# ── Stage 2: lean runtime image ──────────────────────────────────────────────
FROM python:3.11-slim AS runtime

WORKDIR /app

# Only the runtime system libs needed (no build tools, no git, no tesseract in
# the base image — tesseract is optional; install it only if OCR is enabled).
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        libglib2.0-0 \
        libsm6 \
        libxrender1 \
        libxext6 \
        unzip \
    && rm -rf /var/lib/apt/lists/*

# Install AWS CLI v2 (needed for S3 model cache in docker-entrypoint.aws.sh)
RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip \
 && unzip -q /tmp/awscliv2.zip -d /tmp \
 && /tmp/aws/install \
 && rm -rf /tmp/awscliv2.zip /tmp/aws

# Copy pre-built wheels from builder stage
COPY --from=builder /install /usr/local

# Copy application code (models are NOT baked in — mounted or downloaded at runtime)
COPY . .

# Runtime directories
RUN mkdir -p /app/model /app/history /app/feedback /app/logs \
 && chmod +x /app/docker-entrypoint.aws.sh

# ── Environment defaults ──────────────────────────────────────────────────────
ENV PORT=8000
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONOPTIMIZE=1
# Models: load from S3 cache or HF Hub — never baked into image
ENV TRANSFORMERS_OFFLINE=0
ENV HF_DATASETS_OFFLINE=0
ENV HF_HUB_OFFLINE=0
ENV DOWNLOAD_MODELS_ON_START=1
ENV DISABLE_NLLB=0
ENV DISABLE_MARIAN=0
# Cost optimisation: use ONNX INT8 models (fastest, lowest CPU) by default
ENV PREFER_ONNX=1
# AWS cost: single worker keeps RAM under EC2 instance memory limit
ENV UVICORN_WORKERS=1
# Response cache TTL in seconds (reduces repeated inference cost)
ENV TRANSLATION_CACHE_TTL=3600

EXPOSE 8000

# Healthcheck so ECS/ALB can route traffic only when models are ready
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

ENTRYPOINT ["/app/docker-entrypoint.aws.sh"]
