# ── AWS deployment environment variables ─────────────────────────────────────
# Copy this to .env.aws and fill in your values.
# .env.aws is in .gitignore — never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=eu-north-1
S3_MODEL_BUCKET=your-translator-models-bucket
S3_MODEL_PREFIX=models/latest

# ── HuggingFace ──────────────────────────────────────────────────────────────
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ── GitHub (for feedback sync) ────────────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── CORS (comma-separated allowed origins) ───────────────────────────────────
CORS_ORIGINS=https://runyoro-rutooro-translator.vercel.app,https://horizonx.kathay.tech

# ── Caching ───────────────────────────────────────────────────────────────────
TRANSLATION_CACHE_TTL=3600
TRANSLATION_CACHE_MAX=5000

# ── Optional cost flags ───────────────────────────────────────────────────────
# Uncomment on t3.large (8 GB) to stay within memory limit:
# DISABLE_NLLB=1
# Uncomment to force ONNX-only (fastest, cheapest CPU):
# DISABLE_MARIAN=0
PREFER_ONNX=1
